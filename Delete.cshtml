@model SinhVien
@{
    ViewData["Title"] = "Xóa sinh viên";
}
<h2>Xóa sinh viên</h2>

<div class="alert alert-warning">Bạn có chắc chắn muốn xóa sinh viên này không?</div>

@if ((bool)ViewBag.DaCoDangKy)
{
    <div class="alert alert-danger">
        Sinh viên này đã có lịch sử đăng ký đề tài nên KHÔNG THỂ xóa (để bảo toàn lịch sử theo quy định đề bài).
        Hãy chuyển trạng thái sang "Ngừng học" thay vì xóa.
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.MaSinhVien</dd>
    <dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
    <dt class="col-sm-3">Lớp</dt><dd class="col-sm-9">@Model.Lop</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.MaSinhVien" method="post">
    <button type="submit" class="btn btn-danger" disabled="@((bool)ViewBag.DaCoDangKy ? "disabled" : null)">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
