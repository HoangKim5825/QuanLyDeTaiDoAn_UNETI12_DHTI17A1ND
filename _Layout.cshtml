@{
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var daDangNhap = !string.IsNullOrEmpty(vaiTro);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý đề tài đồ án</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Quản lý Đề tài Đồ án</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto">
                    @if (daDangNhap && vaiTro == AppConstants.VaiTro_Admin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="Index">Quản lý sinh viên</a></li>
                    }
                    @if (daDangNhap && vaiTro == AppConstants.VaiTro_SinhVien)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyDeTai" asp-action="DanhSachDeTai">Đăng ký đề tài</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyDeTai" asp-action="Index">Kết quả đăng ký</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="ThongTinCaNhan">Thông tin cá nhân</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (daDangNhap)
                    {
                        <li class="nav-item"><span class="nav-link text-light">Xin chào, @hoTen (@vaiTro)</span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success">@TempData["ThongBao"]</div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger">@TempData["Loi"]</div>
        }

        @RenderBody()
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            Đề tài 12 - Quản lý đề tài đồ án và phân công giảng viên hướng dẫn - ASP.NET Core 10 MVC
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
