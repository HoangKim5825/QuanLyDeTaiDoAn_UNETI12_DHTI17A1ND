@model List<SinhVien>
@{
    ViewData["Title"] = "Quản lý sinh viên";
}
<h2>Quản lý sinh viên</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo mã SV / họ tên / lớp" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Tìm kiếm</button>
    </div>
    <div class="col-auto ms-auto">
        <a asp-action="Create" class="btn btn-primary">+ Thêm sinh viên</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Lớp</th>
            <th>Email</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center">Không có sinh viên nào phù hợp.</td></tr>
        }
        @foreach (var sv in Model)
        {
            <tr>
                <td>@sv.MaSinhVien</td>
                <td>@sv.HoTen</td>
                <td>@sv.Lop</td>
                <td>@sv.Email</td>
                <td>@sv.TrangThai</td>
                <td>
                    <a asp-action="Details" asp-route-id="@sv.MaSinhVien" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@sv.MaSinhVien" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@sv.MaSinhVien" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
