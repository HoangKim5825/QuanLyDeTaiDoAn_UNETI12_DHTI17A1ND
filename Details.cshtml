@model SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}
<h2>Chi tiết sinh viên</h2>

<dl class="row">
    <dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.MaSinhVien</dd>
    <dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
    <dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Lớp</dt><dd class="col-sm-9">@Model.Lop</dd>
    <dt class="col-sm-3">Khoa</dt><dd class="col-sm-9">@Model.Khoa</dd>
    <dt class="col-sm-3">Chuyên ngành</dt><dd class="col-sm-9">@Model.ChuyenNganh</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.SoDienThoai</dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd>
    <dt class="col-sm-3">Tên đăng nhập</dt><dd class="col-sm-9">@Model.TaiKhoan?.TenDangNhap</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
