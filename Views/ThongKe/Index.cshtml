@*
    Họ và tên: Hoàng Kim
    Mã sinh viên: <23203100056>
    Nội dung thực hiện: Module 4 - Giao diện Thống kê
*@
@model QuanLyDeTaiDoAn.ViewModels.ThongKeViewModel
@{
    ViewData["Title"] = "Thống kê";

}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Thống kê</h2>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">Về Dashboard</a>
</div>

@* Partial dạng local function để tái sử dụng cho các bảng "nhãn - số lượng" *@
@functions {
    public static string Rong() => "Chưa có dữ liệu.";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Biểu đồ trực quan</h4>
    <div>
        <small id="thoiGianCapNhat" class="text-muted me-2"></small>
        <button type="button" id="btnLamMoiBieuDo" class="btn btn-sm btn-outline-primary">Làm mới dữ liệu</button>
    </div>
</div>
<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Số đề tài theo lĩnh vực</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartLinhVuc"></div>
                </div>
                <div style="position:relative;height:300px"><canvas id="chartLinhVuc"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Số đăng ký theo trạng thái</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartTrangThai"></div>
                </div>
                <div style="position:relative;height:300px"><canvas id="chartTrangThai"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Số đăng ký theo tháng</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartThang"></div>
                </div>
                <div style="position:relative;height:300px"><canvas id="chartThang"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Số đề tài theo năm học / học kỳ</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartNamHoc"></div>
                </div>
                <div style="position:relative;height:300px"><canvas id="chartNamHoc"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Tải hướng dẫn của giảng viên (đang hướng dẫn / tối đa)</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartGiangVien"></div>
                </div>
                <div style="position:relative;height:340px"><canvas id="chartGiangVien"></canvas></div>
            </div>
        </div>
    </div>

    @* ===== MỚI: tỷ lệ sử dụng giảng viên ===== *@
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Tổng suất hướng dẫn: đã dùng / còn trống</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartSuDung"></div>
                </div>
                <div style="position:relative;height:300px"><canvas id="chartSuDung"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Giảng viên theo mức sử dụng</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartNhomGV"></div>
                </div>
                <div style="position:relative;height:300px"><canvas id="chartNhomGV"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title mb-0">Tỷ lệ sử dụng khả năng hướng dẫn của từng giảng viên (%)</h6>
                    <div class="btn-group btn-group-sm" data-chart="chartTyLeGV"></div>
                </div>
                <div id="boTyLeGV" style="position:relative;height:400px"><canvas id="chartTyLeGV"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Sức chứa từng đề tài (đã duyệt / còn chỗ)</h6>
                <div id="boChoCon" style="position:relative;height:400px"><canvas id="chartChoCon"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <h5>Số đề tài theo lĩnh vực</h5>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Lĩnh vực</th>
                    <th class="text-end">Số đề tài</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.DeTaiTheoLinhVuc)
                {
                    <tr>
                        <td>@x.Nhan</td>
                        <td class="text-end">@x.SoLuong</td>
                    </tr>
                }
                @if (!Model.DeTaiTheoLinhVuc.Any())
                {
                    <tr>
                        <td colspan="2" class="text-muted">@Rong()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h5>Số đăng ký theo trạng thái</h5>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Trạng thái</th>
                    <th class="text-end">Số đăng ký</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.DangKyTheoTrangThai)
                {
                    <tr>
                        <td>@x.Nhan</td>
                        <td class="text-end">@x.SoLuong</td>
                    </tr>
                }
                @if (!Model.DangKyTheoTrangThai.Any())
                {
                    <tr>
                        <td colspan="2" class="text-muted">@Rong()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h5>Số đăng ký theo tháng</h5>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Tháng</th>
                    <th class="text-end">Số đăng ký</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.DangKyTheoThang)
                {
                    <tr>
                        <td>@x.Nhan</td>
                        <td class="text-end">@x.SoLuong</td>
                    </tr>
                }
                @if (!Model.DangKyTheoThang.Any())
                {
                    <tr>
                        <td colspan="2" class="text-muted">@Rong()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h5>Số đề tài theo năm học / học kỳ</h5>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Năm học - Học kỳ</th>
                    <th class="text-end">Số đề tài</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.DeTaiTheoNamHocHocKy)
                {
                    <tr>
                        <td>@x.Nhan</td>
                        <td class="text-end">@x.SoLuong</td>
                    </tr>
                }
                @if (!Model.DeTaiTheoNamHocHocKy.Any())
                {
                    <tr>
                        <td colspan="2" class="text-muted">@Rong()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-12">
        <h5>Số sinh viên và số chỗ còn của từng đề tài</h5>
        <table class="table table-sm table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Đề tài</th>
                    <th>Lĩnh vực</th>
                    <th class="text-end">Tối đa</th>
                    <th class="text-end">Đã duyệt</th>
                    <th class="text-end">Còn chỗ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.DeTaiChoCon)
                {
                    <tr>
                        <td>@x.TenDeTai</td>
                        <td>@x.TenLinhVuc</td>
                        <td class="text-end">@x.SoSinhVienToiDa</td>
                        <td class="text-end">@x.SoDaDuyet</td>
                        <td class="text-end @(x.SoChoCon <= 0 ? "text-danger fw-bold" : "")">@x.SoChoCon</td>
                    </tr>
                }
                @if (!Model.DeTaiChoCon.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted">@Rong()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-12">
        <h5>Giảng viên có số sinh viên hướng dẫn nhiều nhất</h5>
        @if (Model.GiangVienNhieuNhat.Any())
        {
            <ul>
                @foreach (var x in Model.GiangVienNhieuNhat)
                {
                    <li><strong>@x.HoTen</strong> (@x.TenLinhVuc) - @x.SoDangHuongDan sinh viên</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Chưa có giảng viên nào đang hướng dẫn.</p>
        }
    </div>

    <div class="col-12">
        <h5>Tải hướng dẫn và tỷ lệ sử dụng của từng giảng viên</h5>
        <table class="table table-sm table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Giảng viên</th>
                    <th>Lĩnh vực</th>
                    <th class="text-end">Đang hướng dẫn</th>
                    <th class="text-end">Tối đa</th>
                    <th style="width:220px">Tỷ lệ sử dụng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.TaiGiangVien)
                {
                    var mau = x.TyLeSuDung >= 100 ? "bg-danger" : x.TyLeSuDung >= 75 ? "bg-warning" : "bg-success";
                    <tr>
                        <td>@x.HoTen</td>
                        <td>@x.TenLinhVuc</td>
                        <td class="text-end">@x.SoDangHuongDan</td>
                        <td class="text-end">@x.SoToiDa</td>
                        <td>
                            <div class="progress" role="progressbar">
                                <div class="progress-bar @mau"
                                     style="width:@(Math.Min(x.TyLeSuDung, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                                    @x.TyLeSuDung%
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.TaiGiangVien.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted">@Rong()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        let dsLinhVuc = [], dsTrangThai = [], dsThang = [], dsNamHoc = [],
            dsGiangVien = [], dsChoCon = [], dsTyLe = [];

        const mau = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#20c997', '#fd7e14', '#6c757d'];
        const cat = (s, n) => s.length > n ? s.substring(0, n) + '…' : s;
        const soNguyen = { beginAtZero: true, ticks: { precision: 0 } };

        // Vẽ biểu đồ + tự sinh nhóm nút đổi loại.
        // loaiList: [[loai, nhãn nút], ...]; taoCauHinh(loai) trả về cấu hình Chart.js
        const dsChart = {};   // id -> Chart đang hiển thị

        const tao = (id, loaiList, taoCauHinh) => {
            const canvas = document.getElementById(id);
            const nhom = document.querySelector('[data-chart="' + id + '"]');
            const loaiHienTai = dsChart[id] ? dsChart[id].loai : loaiList[0][0];   // giữ loại người dùng đã chọn

            const ve = (loai) => {
                if (dsChart[id]) dsChart[id].chart.destroy();
                dsChart[id] = { chart: new Chart(canvas, taoCauHinh(loai)), loai };
                if (nhom) nhom.querySelectorAll('button').forEach(b =>
                    b.classList.toggle('active', b.dataset.loai === loai));
            };

            if (nhom) {
                nhom.innerHTML = '';
                loaiList.forEach(([loai, nhan]) => {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'btn btn-outline-secondary';
                    b.dataset.loai = loai;
                    b.textContent = nhan;
                    b.addEventListener('click', () => ve(loai));
                    nhom.appendChild(b);
                });
            }
            ve(loaiList.some(l => l[0] === loaiHienTai) ? loaiHienTai : loaiList[0][0]);
        };

        const khongDuLieu = (id) => {
            if (dsChart[id]) { dsChart[id].chart.destroy(); delete dsChart[id]; }
            const canvas = document.getElementById(id);
            const bo = canvas.parentElement;
            let tb = bo.querySelector('.khong-du-lieu');
            if (!tb) {
                tb = document.createElement('p');
                tb.className = 'khong-du-lieu text-muted text-center mt-5';
                tb.textContent = 'Chưa có dữ liệu.';
                bo.appendChild(tb);
            }
            canvas.style.display = 'none';
        };
        const coDuLieu = (id) => {
            const canvas = document.getElementById(id);
            canvas.style.display = '';
            const tb = canvas.parentElement.querySelector('.khong-du-lieu');
            if (tb) tb.remove();
        };

        function veTatCa() {

            // 1. Đề tài theo lĩnh vực
            if (dsLinhVuc.length) {
                coDuLieu('chartLinhVuc');
                tao('chartLinhVuc', nutTronCot, l =>
                    cauHinhDanhMuc(dsLinhVuc.map(x => x.nhan), dsLinhVuc.map(x => x.soLuong), 'Số đề tài', l));
            } else khongDuLieu('chartLinhVuc');

            // 2. Đăng ký theo trạng thái
            if (dsTrangThai.length) {
                coDuLieu('chartTrangThai');
                tao('chartTrangThai', [['pie', 'Tròn'], ['doughnut', 'Vành khuyên'], ['bar', 'Cột']], l =>
                    cauHinhDanhMuc(dsTrangThai.map(x => x.nhan), dsTrangThai.map(x => x.soLuong), 'Số đăng ký', l));
            } else khongDuLieu('chartTrangThai');

            // 3. Đăng ký theo tháng
            if (dsThang.length) {
                coDuLieu('chartThang');
                tao('chartThang', nutDuongCot, l =>
                    cauHinhDanhMuc(dsThang.map(x => x.nhan), dsThang.map(x => x.soLuong), 'Số đăng ký', l));
            } else khongDuLieu('chartThang');

            // 4. Đề tài theo năm học / học kỳ
            if (dsNamHoc.length) {
                coDuLieu('chartNamHoc');
                tao('chartNamHoc', nutCotDuong, l =>
                    cauHinhDanhMuc(dsNamHoc.map(x => x.nhan), dsNamHoc.map(x => x.soLuong), 'Số đề tài', l));
            } else khongDuLieu('chartNamHoc');

            // 5. Tải giảng viên
            if (dsGiangVien.length) {
                coDuLieu('chartGiangVien');
                tao('chartGiangVien', [['bar', 'Cột'], ['line', 'Đường'], ['barH', 'Ngang']], l => {
                    const ngang = l === 'barH';
                    return {
                        type: ngang ? 'bar' : l,
                        data: {
                            labels: dsGiangVien.map(x => cat(x.hoTen, 14)),
                            datasets: [
                                {
                                    label: 'Đang hướng dẫn', data: dsGiangVien.map(x => x.soDangHuongDan),
                                    backgroundColor: '#0d6efd', borderColor: '#0d6efd', tension: .3
                                },
                                {
                                    label: 'Tối đa', data: dsGiangVien.map(x => x.soToiDa),
                                    backgroundColor: l === 'line' ? '#adb5bd' : '#dee2e6', borderColor: '#adb5bd', tension: .3
                                }
                            ]
                        },
                        options: {
                            maintainAspectRatio: false,
                            indexAxis: ngang ? 'y' : 'x',
                            scales: ngang ? { x: soNguyen } : { y: soNguyen },
                            plugins: { tooltip: { callbacks: { title: i => dsGiangVien[i[0].dataIndex].hoTen } } }
                        }
                    };
                });
            } else khongDuLieu('chartGiangVien');

            // 6. Tổng suất hướng dẫn
            if (dsTyLe.length) {
                coDuLieu('chartSuDung');
                const tongDung = dsTyLe.reduce((s, x) => s + x.soDangHuongDan, 0);
                const tongMax = dsTyLe.reduce((s, x) => s + x.soToiDa, 0);
                tao('chartSuDung', [['doughnut', 'Vành khuyên'], ['pie', 'Tròn']], l => ({
                    type: l,
                    data: {
                        labels: ['Đã dùng', 'Còn trống'],
                        datasets: [{ data: [tongDung, Math.max(0, tongMax - tongDung)], backgroundColor: ['#0d6efd', '#dee2e6'] }]
                    },
                    options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                }));
            } else khongDuLieu('chartSuDung');

            // 7. Giảng viên theo mức sử dụng
            if (dsTyLe.length) {
                coDuLieu('chartNhomGV');
                const nhom = [
                    { nhan: 'Chưa hướng dẫn', dem: dsTyLe.filter(x => x.soDangHuongDan === 0).length },
                    { nhan: 'Dưới 75%', dem: dsTyLe.filter(x => x.soDangHuongDan > 0 && x.tyLeSuDung < 75).length },
                    { nhan: 'Từ 75% đến dưới 100%', dem: dsTyLe.filter(x => x.tyLeSuDung >= 75 && x.tyLeSuDung < 100).length },
                    { nhan: 'Đạt giới hạn', dem: dsTyLe.filter(x => x.tyLeSuDung >= 100).length }
                ];
                tao('chartNhomGV', [['pie', 'Tròn'], ['doughnut', 'Vành khuyên'], ['bar', 'Cột']], l => ({
                    type: l,
                    data: {
                        labels: nhom.map(x => x.nhan),
                        datasets: [{
                            label: 'Số giảng viên', data: nhom.map(x => x.dem),
                            backgroundColor: ['#6c757d', '#198754', '#ffc107', '#dc3545']
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: { legend: { display: l !== 'bar', position: 'bottom' } },
                        scales: l === 'bar' ? { y: soNguyen } : {}
                    }
                }));
            } else khongDuLieu('chartNhomGV');

            // 8. Tỷ lệ sử dụng từng giảng viên
            if (dsTyLe.length) {
                coDuLieu('chartTyLeGV');
                document.getElementById('boTyLeGV').style.height = (dsTyLe.length * 28 + 80) + 'px';
                const mauTyLe = dsTyLe.map(x => x.tyLeSuDung >= 100 ? '#dc3545' : x.tyLeSuDung >= 75 ? '#ffc107' : '#198754');
                tao('chartTyLeGV', [['barH', 'Ngang'], ['bar', 'Cột'], ['radar', 'Radar']], l => {
                    const ngang = l === 'barH';
                    const truc = { beginAtZero: true, suggestedMax: 100, ticks: { callback: v => v + '%' } };
                    return {
                        type: ngang ? 'bar' : l,
                        data: {
                            labels: dsTyLe.map(x => cat(x.hoTen, 16)),
                            datasets: [{
                                label: 'Tỷ lệ sử dụng (%)',
                                data: dsTyLe.map(x => x.tyLeSuDung),
                                backgroundColor: l === 'radar' ? 'rgba(13,110,253,.2)' : mauTyLe,
                                borderColor: '#0d6efd'
                            }]
                        },
                        options: {
                            maintainAspectRatio: false,
                            indexAxis: ngang ? 'y' : 'x',
                            plugins: {
                                legend: { display: false },
                                tooltip: { callbacks: { title: i => dsTyLe[i[0].dataIndex].hoTen } }
                            },
                            scales: l === 'radar' ? { r: { beginAtZero: true, suggestedMax: 100 } }
                                : ngang ? { x: truc } : { y: truc }
                        }
                    };
                });
            } else khongDuLieu('chartTyLeGV');

            // 9. Sức chứa đề tài
            if (dsChoCon.length) {
                coDuLieu('chartChoCon');
                document.getElementById('boChoCon').style.height = (dsChoCon.length * 26 + 90) + 'px';
                if (dsChart['chartChoCon']) dsChart['chartChoCon'].chart.destroy();
                dsChart['chartChoCon'] = {
                    loai: 'barH',
                    chart: new Chart('chartChoCon', {
                        type: 'bar',
                        data: {
                            labels: dsChoCon.map(x => cat(x.tenDeTai, 40)),
                            datasets: [
                                { label: 'Đã duyệt', data: dsChoCon.map(x => x.soDaDuyet), backgroundColor: '#198754' },
                                { label: 'Còn chỗ', data: dsChoCon.map(x => x.soChoCon), backgroundColor: '#ffc107' }
                            ]
                        },
                        options: {
                            indexAxis: 'y', maintainAspectRatio: false,
                            scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } },
                            plugins: { tooltip: { callbacks: { title: i => dsChoCon[i[0].dataIndex].tenDeTai } } }
                        }
                    })
                };
            } else khongDuLieu('chartChoCon');
        }

        // ===== AJAX: nạp JSON rồi vẽ =====
        async function napDuLieu() {
            const btn = document.getElementById('btnLamMoiBieuDo');
            btn.disabled = true;
            btn.textContent = 'Đang tải...';
            try {
                const res = await fetch('@Url.Action("DuLieuJson")');
                if (res.redirected || !(res.headers.get('content-type') || '').includes('json'))
                    throw new Error('Phiên đăng nhập đã hết. Hãy tải lại trang.');
                const d = await res.json();

                dsLinhVuc = d.linhVuc;
                dsTrangThai = d.trangThai;
                dsThang = d.thang;
                dsNamHoc = d.namHoc;
                dsGiangVien = d.giangVien;
                dsTyLe = d.giangVien;   // cùng nguồn, đã có tyLeSuDung
                dsChoCon = d.choCon;

                veTatCa();
                document.getElementById('thoiGianCapNhat').textContent =
                    'Cập nhật lúc ' + new Date().toLocaleTimeString('vi-VN');
            } catch (e) {
                alert(e.message);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Làm mới dữ liệu';
            }
        }

        document.getElementById('btnLamMoiBieuDo').addEventListener('click', napDuLieu);
        napDuLieu();   // nạp lần đầu khi mở trang

        // Cấu hình dùng chung cho dữ liệu dạng "nhãn - số lượng"
        // Hỗ trợ: doughnut, pie, bar (cột), barH (cột ngang), line
        const cauHinhDanhMuc = (labels, data, tenDuLieu, loai) => {
            const tron = loai === 'doughnut' || loai === 'pie';
            const ngang = loai === 'barH';
            return {
                type: ngang ? 'bar' : loai,
                data: {
                    labels: labels,
                    datasets: [{
                        label: tenDuLieu,
                        data: data,
                        backgroundColor: loai === 'line' ? 'rgba(13,110,253,.15)' : mau,
                        borderColor: loai === 'line' ? '#0d6efd' : undefined,
                        fill: loai === 'line',
                        tension: .3
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    indexAxis: ngang ? 'y' : 'x',
                    plugins: { legend: { display: tron, position: 'bottom' } },
                    scales: tron ? {} : (ngang ? { x: soNguyen } : { y: soNguyen })
                }
            };
        };

        const nutTronCot = [['doughnut', 'Vành khuyên'], ['pie', 'Tròn'], ['bar', 'Cột']];
        const nutCotDuong = [['bar', 'Cột'], ['line', 'Đường'], ['barH', 'Ngang']];
        const nutDuongCot = [['line', 'Đường'], ['bar', 'Cột']];

        // 1. Đề tài theo lĩnh vực
        if (dsLinhVuc.length)
            tao('chartLinhVuc', nutTronCot, l =>
                cauHinhDanhMuc(dsLinhVuc.map(x => x.Nhan), dsLinhVuc.map(x => x.SoLuong), 'Số đề tài', l));
        else khongDuLieu('chartLinhVuc');

        // 2. Đăng ký theo trạng thái
        if (dsTrangThai.length)
            tao('chartTrangThai', [['pie', 'Tròn'], ['doughnut', 'Vành khuyên'], ['bar', 'Cột']], l =>
                cauHinhDanhMuc(dsTrangThai.map(x => x.Nhan), dsTrangThai.map(x => x.SoLuong), 'Số đăng ký', l));
        else khongDuLieu('chartTrangThai');

        // 3. Đăng ký theo tháng
        if (dsThang.length)
            tao('chartThang', nutDuongCot, l =>
                cauHinhDanhMuc(dsThang.map(x => x.Nhan), dsThang.map(x => x.SoLuong), 'Số đăng ký', l));
        else khongDuLieu('chartThang');

        // 4. Đề tài theo năm học / học kỳ
        if (dsNamHoc.length)
            tao('chartNamHoc', nutCotDuong, l =>
                cauHinhDanhMuc(dsNamHoc.map(x => x.Nhan), dsNamHoc.map(x => x.SoLuong), 'Số đề tài', l));
        else khongDuLieu('chartNamHoc');

        // 5. Tải giảng viên: 2 dataset (đang hướng dẫn vs tối đa)
        if (dsGiangVien.length)
            tao('chartGiangVien', [['bar', 'Cột'], ['line', 'Đường'], ['barH', 'Ngang']], l => {
                const ngang = l === 'barH';
                return {
                    type: ngang ? 'bar' : l,
                    data: {
                        labels: dsGiangVien.map(x => cat(x.HoTen, 14)),
                        datasets: [
                            {
                                label: 'Đang hướng dẫn', data: dsGiangVien.map(x => x.SoDangHuongDan),
                                backgroundColor: '#0d6efd', borderColor: '#0d6efd', tension: .3
                            },
                            {
                                label: 'Tối đa', data: dsGiangVien.map(x => x.SoToiDa),
                                backgroundColor: l === 'line' ? '#adb5bd' : '#dee2e6', borderColor: '#adb5bd', tension: .3
                            }
                        ]
                    },
                    options: {
                        maintainAspectRatio: false,
                        indexAxis: ngang ? 'y' : 'x',
                        scales: ngang ? { x: soNguyen } : { y: soNguyen },
                        plugins: { tooltip: { callbacks: { title: i => dsGiangVien[i[0].dataIndex].HoTen } } }
                    }
                };
            });
        else khongDuLieu('chartGiangVien');

        // ===== MỚI 6. Tổng suất hướng dẫn: đã dùng / còn trống =====
        if (dsTyLe.length) {
            const tongDung = dsTyLe.reduce((s, x) => s + x.SoDangHuongDan, 0);
            const tongMax = dsTyLe.reduce((s, x) => s + x.SoToiDa, 0);
            tao('chartSuDung', [['doughnut', 'Vành khuyên'], ['pie', 'Tròn']], l => ({
                type: l,
                data: {
                    labels: ['Đã dùng', 'Còn trống'],
                    datasets: [{ data: [tongDung, Math.max(0, tongMax - tongDung)], backgroundColor: ['#0d6efd', '#dee2e6'] }]
                },
                options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            }));
        } else { khongDuLieu('chartSuDung'); }

        // ===== MỚI 7. Giảng viên theo mức sử dụng =====
        if (dsTyLe.length) {
            const nhom = [
                { nhan: 'Chưa hướng dẫn', dem: dsTyLe.filter(x => x.SoDangHuongDan === 0).length },
                { nhan: 'Dưới 75%', dem: dsTyLe.filter(x => x.SoDangHuongDan > 0 && x.TyLeSuDung < 75).length },
                { nhan: 'Từ 75% đến dưới 100%', dem: dsTyLe.filter(x => x.TyLeSuDung >= 75 && x.TyLeSuDung < 100).length },
                { nhan: 'Đạt giới hạn', dem: dsTyLe.filter(x => x.TyLeSuDung >= 100).length }
            ];
            const mauNhom = ['#6c757d', '#198754', '#ffc107', '#dc3545'];
            tao('chartNhomGV', [['pie', 'Tròn'], ['doughnut', 'Vành khuyên'], ['bar', 'Cột']], l => ({
                type: l,
                data: {
                    labels: nhom.map(x => x.nhan),
                    datasets: [{ label: 'Số giảng viên', data: nhom.map(x => x.dem), backgroundColor: mauNhom }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: l !== 'bar', position: 'bottom' } },
                    scales: l === 'bar' ? { y: soNguyen } : {}
                }
            }));
        } else { khongDuLieu('chartNhomGV'); }

        // ===== MỚI 8. Tỷ lệ sử dụng từng giảng viên (%) =====
        if (dsTyLe.length) {
            const mauTyLe = dsTyLe.map(x => x.TyLeSuDung >= 100 ? '#dc3545' : x.TyLeSuDung >= 75 ? '#ffc107' : '#198754');
            tao('chartTyLeGV', [['barH', 'Ngang'], ['bar', 'Cột'], ['radar', 'Radar']], l => {
                const ngang = l === 'barH';
                const truc = { beginAtZero: true, suggestedMax: 100, ticks: { callback: v => v + '%' } };
                return {
                    type: ngang ? 'bar' : l,
                    data: {
                        labels: dsTyLe.map(x => cat(x.HoTen, 16)),
                        datasets: [{
                            label: 'Tỷ lệ sử dụng (%)',
                            data: dsTyLe.map(x => x.TyLeSuDung),
                            backgroundColor: l === 'radar' ? 'rgba(13,110,253,.2)' : mauTyLe,
                            borderColor: '#0d6efd'
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        indexAxis: ngang ? 'y' : 'x',
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { title: i => dsTyLe[i[0].dataIndex].HoTen } }
                        },
                        scales: l === 'radar' ? { r: { beginAtZero: true, suggestedMax: 100 } }
                            : ngang ? { x: truc } : { y: truc }
                    }
                };
            });
        } else { khongDuLieu('chartTyLeGV'); }

        // 9. Sức chứa đề tài - stacked bar ngang (giữ cố định vì nhiều nhãn)
        if (dsChoCon.length) new Chart('chartChoCon', {
            type: 'bar',
            data: {
                labels: dsChoCon.map(x => cat(x.TenDeTai, 40)),
                datasets: [
                    { label: 'Đã duyệt', data: dsChoCon.map(x => x.SoDaDuyet), backgroundColor: '#198754' },
                    { label: 'Còn chỗ', data: dsChoCon.map(x => x.SoChoCon), backgroundColor: '#ffc107' }
                ]
            },
            options: {
                indexAxis: 'y', maintainAspectRatio: false,
                scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } },
                plugins: { tooltip: { callbacks: { title: i => dsChoCon[i[0].dataIndex].TenDeTai } } }
            }
        }); else khongDuLieu('chartChoCon');
    </script>
}