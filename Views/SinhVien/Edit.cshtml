@*
    Họ và tên: <ĐIỀN TÊN>
    Mã sinh viên: <ĐIỀN MÃ SV>
    Nội dung thực hiện: Module 3 - View sửa sinh viên
*@
@model QuanLyDeTaiDoAn.Models.SinhVien
@{
    ViewData["Title"] = "Sửa sinh viên";
}

<h1 class="h3 mb-3">Sửa sinh viên</h1>

<form asp-action="Edit" asp-route-id="@Model.MaSinhVien" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="MaSinhVien" />
    <partial name="_Form" model="Model" />
    <div class="form-text mt-2">Bỏ chọn "Đang hoạt động" để ngừng cho sinh viên đăng ký đề tài; lịch sử đăng ký và phân công vẫn được giữ lại.</div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
