@*
    Họ và tên: <ĐIỀN TÊN>
    Mã sinh viên: <ĐIỀN MÃ SV>
    Nội dung thực hiện: Module 3 - Các trường nhập liệu dùng chung cho Create/Edit sinh viên
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@model QuanLyDeTaiDoAn.Models.SinhVien
@{
    bool laTao = ViewBag.TaiKhoans != null;
}

<div class="row g-3">
    <div class="col-12 col-md-6">
        @if (laTao)
        {
            <label asp-for="MaTaiKhoan" class="form-label"></label>
            <select asp-for="MaTaiKhoan" asp-items="(IEnumerable<SelectListItem>)ViewBag.TaiKhoans" class="form-select">
                <option value="">-- Chọn tài khoản sinh viên chưa có hồ sơ --</option>
            </select>
            <span asp-validation-for="MaTaiKhoan" class="text-danger"></span>
        }
        else
        {
            <label class="form-label">Tài khoản liên kết</label>
            <input class="form-control" value="@ViewBag.TenDangNhap" disabled />
        }
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="HoTen" class="form-label"></label>
        <input asp-for="HoTen" class="form-control" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="col-6 col-md-4">
        <label asp-for="NgaySinh" class="form-label"></label>
        <input asp-for="NgaySinh" type="date" class="form-control" />
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-4">
        <label asp-for="Lop" class="form-label"></label>
        <input asp-for="Lop" class="form-control" />
        <span asp-validation-for="Lop" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="SoDienThoai" class="form-label"></label>
        <input asp-for="SoDienThoai" type="tel" class="form-control" />
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Khoa" class="form-label"></label>
        <input asp-for="Khoa" class="form-control" />
        <span asp-validation-for="Khoa" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="ChuyenNganh" class="form-label"></label>
        <input asp-for="ChuyenNganh" class="form-control" />
        <span asp-validation-for="ChuyenNganh" class="text-danger"></span>
    </div>

    <div class="col-12 col-md-8">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="TrangThai" class="form-check-input" />
            <label asp-for="TrangThai" class="form-check-label"></label>
        </div>
    </div>
</div>
