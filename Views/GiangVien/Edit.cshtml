@*
    Họ và tên: <Nguyen Quang Huy>
    Mã sinh viên: <23203100080>
    Nội dung thực hiện: View sửa giảng viên (Module 2)
*@
@model QuanLyDeTaiDoAn.Models.GiangVien

@{
    ViewData["Title"] = "Sửa giảng viên";
    int tai = ViewBag.TaiHienTai is int n ? n : 0;
}

<h1 class="h3 mb-3">Sửa giảng viên</h1>

@if (tai > 0)
{
    <div class="alert alert-info" role="status">
        Giảng viên đang hướng dẫn <strong>@tai</strong> sinh viên, nên giới hạn hướng dẫn tối đa không được nhỏ hơn @tai.
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.MaGiangVien" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="MaGiangVien" />

    <partial name="_Form" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
