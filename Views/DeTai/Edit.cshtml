@*
    Họ và tên: <ĐIỀN TÊN>
    Mã sinh viên: <ĐIỀN MÃ SV>
    Nội dung thực hiện: View sửa đề tài (Module 2)
*@
@model QuanLyDeTaiDoAn.Models.DeTai

@{
    ViewData["Title"] = "Sửa đề tài";
    int soDaDuyet = ViewBag.SoDaDuyet is int n ? n : 0;
}

<h1 class="h3 mb-3">Sửa đề tài</h1>

@if (soDaDuyet > 0)
{
    <div class="alert alert-info" role="status">
        Đề tài này đang có <strong>@soDaDuyet</strong> đăng ký được duyệt, nên số sinh viên tối đa không được nhỏ hơn @soDaDuyet.
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.MaDeTai" method="post" enctype="multipart/form-data" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="MaDeTai" />

    <partial name="_Form" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Kiểm tra nhanh ở trình duyệt cho tiện. Máy chủ vẫn kiểm tra lại đầy đủ.
        document.getElementById('fileMoTa').addEventListener('change', function () {
            const f = this.files[0];
            if (!f) return;
            const duoi = f.name.split('.').pop().toLowerCase();
            if (!['pdf', 'doc', 'docx'].includes(duoi)) {
                alert('Chỉ chấp nhận file .pdf, .doc hoặc .docx.');
                this.value = '';
            } else if (f.size > 5 * 1024 * 1024) {
                alert('File vượt quá 5 MB.');
                this.value = '';
            }
        });
    </script>
}
