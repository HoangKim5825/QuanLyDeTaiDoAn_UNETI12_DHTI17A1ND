@model QuanLyDeTaiDoAn.Models.DeTai

@{
    ViewData["Title"] = "Thêm đề tài";
}

<h1 class="h3 mb-3">Thêm đề tài</h1>

<form asp-action="Create" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="_Form" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu đề tài</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
