@*
    Họ và tên: <ĐIỀN TÊN>
    Mã sinh viên: <ĐIỀN MÃ SV>
    Nội dung thực hiện: View danh sách đề tài - tìm kiếm, lọc, sắp xếp, phân trang, AJAX, xuất Excel (Module 2)
*@
@using Microsoft.AspNetCore.Http
@model QuanLyDeTaiDoAn.ViewModels.DeTaiFilterViewModel

@{
    ViewData["Title"] = "Danh sách đề tài";

    // Chỉ để ẩn/hiện nút. Quyền thật sự được kiểm tra ở Controller.
    var laAdmin = Context.Session.GetString("VaiTro") == "Admin";

    bool dangLoc = !string.IsNullOrWhiteSpace(Model.Keyword) || Model.MaLinhVuc.HasValue
        || Model.NamHoc.HasValue || !string.IsNullOrEmpty(Model.HocKy)
        || !string.IsNullOrEmpty(Model.TrangThai) || Model.ConCho.HasValue;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Danh sách đề tài</h1>
    <div class="d-flex gap-2">
        @if (laAdmin)
        {
            <a id="nutExcel" asp-action="ExportExcel" asp-all-route-data="Model.RouteValues(1)"
               data-base="@Url.Action("ExportExcel")" class="btn btn-outline-success">Xuất Excel</a>
            <a asp-action="Create" class="btn btn-primary">Thêm đề tài</a>
        }
    </div>
</div>

<partial name="_ThongBao" />

@* Form GET: điều kiện nằm trên URL. Có JavaScript thì tự cập nhật kết quả (AJAX), không có thì vẫn gửi form bình thường. *@
<form id="formLoc" asp-action="Index" method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-12 col-lg-6">
            <label asp-for="Keyword" class="form-label">Từ khóa</label>
            <input asp-for="Keyword" class="form-control" placeholder="Tên đề tài, mô tả hoặc yêu cầu" autocomplete="off" />
        </div>
        <div class="col-6 col-lg-3">
            <label asp-for="MaLinhVuc" class="form-label">Lĩnh vực</label>
            <select asp-for="MaLinhVuc" asp-items="Model.LinhVucs" class="form-select">
                <option value="">Tất cả</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" asp-items="Model.TrangThais" class="form-select">
                <option value="">Tất cả</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="NamHoc" class="form-label">Năm học</label>
            <select asp-for="NamHoc" asp-items="Model.NamHocs" class="form-select">
                <option value="">Tất cả</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="HocKy" class="form-label">Học kỳ</label>
            <select asp-for="HocKy" asp-items="Model.HocKys" class="form-select">
                <option value="">Tất cả</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="ConCho" class="form-label">Số chỗ</label>
            <select name="ConCho" id="ConCho" class="form-select">
                <option value="">Tất cả</option>
                <option value="true" selected="@(Model.ConCho == true)">Còn chỗ</option>
                <option value="false" selected="@(Model.ConCho == false)">Hết chỗ</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label asp-for="SortOrder" class="form-label">Sắp xếp</label>
            <select asp-for="SortOrder" asp-items="Model.CacKieuSapXep" class="form-select"></select>
        </div>
        <div class="col-6 col-lg-1">
            <label asp-for="PageSize" class="form-label">Số dòng</label>
            <select name="PageSize" id="PageSize" class="form-select">
                @foreach (var n in new[] { 5, 8, 12, 20 })
                {
                    <option value="@n" selected="@(Model.PageSize == n)">@n</option>
                }
            </select>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Tìm và lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
    </div>
</form>

@* Vùng này được thay bằng kết quả mới mỗi khi tìm, lọc, sắp xếp hoặc chuyển trang *@
<div id="ketQua" aria-live="polite">
    <partial name="_DanhSach" model="Model" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('formLoc');
            const box = document.getElementById('ketQua');
            const nutExcel = document.getElementById('nutExcel');
            let timer = null;
            let yeuCauMoiNhat = 0;

            // Chuỗi query từ form, bỏ các ô để trống
            function queryTuForm() {
                const p = new URLSearchParams(new FormData(form));
                for (const k of [...p.keys()]) if (p.get(k) === '') p.delete(k);
                return p.toString();
            }

            async function taiLai(url) {
                const stt = ++yeuCauMoiNhat;
                try {
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (res.redirected) { window.location.href = res.url; return; }   // hết phiên đăng nhập
                    if (!res.ok) throw new Error(res.status);
                    const html = await res.text();
                    if (stt !== yeuCauMoiNhat) return;      // bỏ kết quả cũ nếu đã có yêu cầu mới hơn
                    box.innerHTML = html;
                    history.replaceState(null, '', url);    // URL luôn phản ánh bộ lọc hiện tại
                    if (nutExcel) nutExcel.href = nutExcel.dataset.base + '?' + new URL(url, location.href).searchParams.toString();
                } catch (e) {
                    window.location.href = url;             // lỗi thì quay về tải trang bình thường
                }
            }

            function capNhatTuForm() {
                const q = queryTuForm();
                taiLai(form.action + (q ? '?' + q : ''));
            }

            // Gõ hoặc đổi ô lọc: đợi 300ms rồi cập nhật
            form.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(capNhatTuForm, 300);
            });
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                clearTimeout(timer);
                capNhatTuForm();
            });

            // Bấm số trang: tải lại phần danh sách, giữ nguyên điều kiện (link đã chứa đủ điều kiện)
            box.addEventListener('click', function (e) {
                const a = e.target.closest('a.page-link');
                if (!a) return;
                e.preventDefault();
                if (a.closest('li.disabled') || a.closest('li.active')) return;
                taiLai(a.href);
            });
        })();
    </script>
}
