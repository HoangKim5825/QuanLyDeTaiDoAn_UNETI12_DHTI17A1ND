@*
    Họ và tên: Nguyễn Minh Đức
    Mã sinh viên: 23203100078
    Nội dung thực hiện: Module 1 - View danh sách tài khoản
*@
@model List<QuanLyDeTaiDoAn.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    int? maHienTai = ViewBag.MaTaiKhoanHienTai as int?;
}

<partial name="_ThongBao" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý tài khoản</h3>
    <a class="btn btn-primary" asp-action="Create">+ Thêm tài khoản</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên đăng nhập, họ tên, email..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Tên đăng nhập</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th style="width: 340px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tk in Model)
        {
            bool laToi = maHienTai == tk.MaTaiKhoan;
            <tr>
                <td>
                    @tk.TenDangNhap
                    @if (laToi)
                    {
                        <span class="badge bg-primary ms-1">Bạn</span>
                    }
                </td>
                <td>@tk.HoTen</td>
                <td>@tk.Email</td>
                <td><span class="badge bg-info text-dark">@tk.VaiTro</span></td>
                <td>
                    @if (tk.TrangThai)
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã khóa</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@tk.MaTaiKhoan">Chi tiết</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@tk.MaTaiKhoan">Sửa</a>
                    <a class="btn btn-sm btn-outline-dark" asp-action="DoiMatKhau" asp-route-id="@tk.MaTaiKhoan">Đổi MK</a>

                    @if (laToi)
                    {
                        <span class="text-muted small ms-1">Không thể tự khóa/xóa</span>
                    }
                    else
                    {
                        <form asp-action="ToggleKhoa" asp-route-id="@tk.MaTaiKhoan" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(tk.TrangThai ? "Khóa" : "Mở khóa")
                            </button>
                        </form>

                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@tk.MaTaiKhoan">Xóa</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
