@*
    Họ và tên: Nguyễn Minh Đức
    Mã sinh viên: 23203100078
    Nội dung thực hiện: Module 1 - View xác nhận xóa tài khoản
*@
@model QuanLyDeTaiDoAn.Models.TaiKhoan
@{
    ViewData["Title"] = "Xóa tài khoản";
}

<h3 class="text-danger">Xác nhận xóa tài khoản</h3>

@{
    bool laToi = (ViewBag.LaChinhMinh as bool?) == true;
    bool coHoSo = (ViewBag.CoHoSoSinhVien as bool?) == true;
    bool khongXoaDuoc = laToi || coHoSo;
}

@if (laToi)
{
    <div class="alert alert-warning">
        Đây là <b>tài khoản bạn đang đăng nhập</b> nên không thể tự xóa chính mình.
    </div>
}

@if (coHoSo)
{
    <div class="alert alert-warning">
        Tài khoản này đã có hồ sơ <b>Sinh viên</b> liên kết (do Module Sinh viên quản lý).
        Hệ thống sẽ <b>không cho xóa</b> để tránh mất dữ liệu liên quan — hãy dùng chức năng
        <b>Khóa tài khoản</b> ở trang danh sách thay vì xóa.
    </div>
}

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.TenDangNhap)</dt>
    <dd class="col-sm-9">@Model.TenDangNhap</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.HoTen)</dt>
    <dd class="col-sm-9">@Model.HoTen</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.VaiTro)</dt>
    <dd class="col-sm-9">@Model.VaiTro</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.MaTaiKhoan" method="post">
    <input type="hidden" asp-for="MaTaiKhoan" />
    <button type="submit" class="btn btn-danger" @(khongXoaDuoc ? "disabled" : "")>Xác nhận xóa</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>
