@using Microsoft.AspNetCore.Http
@{
    var vaiTro = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen");
    bool daDangNhap = !string.IsNullOrEmpty(vaiTro);
    bool laAdmin = vaiTro == "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyDeTaiDoAn_UNETI12_DHTI17A1ND</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyDeTaiDoAn_UNETI12_DHTI17A1ND.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">QuanLyDeTaiDoAn_UNETI12_DHTI17A1ND</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @if (daDangNhap)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="DeTai" asp-action="Index">Đề tài</a>
                            </li>
                        }

                        @if (laAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="LinhVuc" asp-action="Index">Lĩnh vực</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="GiangVien" asp-action="Index">Giảng viên</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a>
                            </li>

                            @* ===== Module 4 ===== *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Duyệt &amp; phân công
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="PhanCongHuongDan" asp-action="DanhSachChoDuyet">Đăng ký chờ duyệt</a></li>
                                    <li><a class="dropdown-item" asp-controller="PhanCongHuongDan" asp-action="DanhSachChoDuyet" asp-route-trangThai="DaDuyet">Đã duyệt / Phân công GVHD</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ThongKe" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ThongKe" asp-action="Index">Thống kê</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (daDangNhap)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-2">Xin chào, <strong>@hoTen</strong> (@(laAdmin ? "Admin" : "Sinh viên"))</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyDeTaiDoAn_UNETI12_DHTI17A1ND - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
