@*
    Họ và tên: [Điền họ tên của bạn]
    Mã sinh viên: [Điền mã sinh viên của bạn]
    Nội dung thực hiện: Module 1 - View thêm lĩnh vực
*@
@model QuanLyDeTaiDoAn.Models.LinhVuc
@{
    ViewData["Title"] = "Thêm lĩnh vực";
}

<h3>Thêm lĩnh vực mới</h3>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="TenLinhVuc" class="form-label"></label>
        <input asp-for="TenLinhVuc" class="form-control" />
        <span asp-validation-for="TenLinhVuc" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MoTa" class="form-label"></label>
        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="TrangThai" class="form-check-input" />
        <label asp-for="TrangThai" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
