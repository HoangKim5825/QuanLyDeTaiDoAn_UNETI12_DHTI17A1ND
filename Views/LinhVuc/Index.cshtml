@*
    Họ và tên: Nguyễn Minh Đức
    Mã sinh viên: 23203100078
    Nội dung thực hiện: Module 1 - View danh sách lĩnh vực
*@
@model List<QuanLyDeTaiDoAn.Models.LinhVuc>
@{
    ViewData["Title"] = "Quản lý lĩnh vực";
}

<partial name="_ThongBao" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý lĩnh vực đề tài</h3>
    <a class="btn btn-primary" asp-action="Create">+ Thêm lĩnh vực</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên lĩnh vực..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Không tìm thấy lĩnh vực nào phù hợp.</div>
}
else
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên lĩnh vực</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th style="width:220px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenLinhVuc</td>
                    <td>@item.MoTa</td>
                    <td>
                        @if (item.TrangThai)
                        {
                            <span class="badge bg-success">Đang áp dụng</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ngừng áp dụng</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.MaLinhVuc">Chi tiết</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MaLinhVuc">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.MaLinhVuc">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
