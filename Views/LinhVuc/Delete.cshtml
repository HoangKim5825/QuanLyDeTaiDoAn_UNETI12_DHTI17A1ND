@*
    Họ và tên: Nguyễn Minh Đức
    Mã sinh viên: 23203100078
    Nội dung thực hiện: Module 1 - View xác nhận xóa lĩnh vực
*@
@model QuanLyDeTaiDoAn.Models.LinhVuc
@{
    ViewData["Title"] = "Xóa lĩnh vực";
}

<h3 class="text-danger">Xác nhận xóa lĩnh vực</h3>

@{
    int soGv = (int)ViewBag.SoGiangVien;
    int soDt = (int)ViewBag.SoDeTai;
    bool dangDung = soGv > 0 || soDt > 0;
}

@if (dangDung)
{
    <div class="alert alert-warning">
        Lĩnh vực này đang được <b>@soGv</b> giảng viên và <b>@soDt</b> đề tài sử dụng.
        Hệ thống sẽ <b>không cho xóa</b> — hãy chuyển Trạng thái sang "Ngừng áp dụng" thay vì xóa.
    </div>
}

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.TenLinhVuc)</dt>
    <dd class="col-sm-10">@Model.TenLinhVuc</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.MoTa)</dt>
    <dd class="col-sm-10">@Model.MoTa</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.MaLinhVuc" method="post">
    <input type="hidden" asp-for="MaLinhVuc" />
    <button type="submit" class="btn btn-danger" @(dangDung ? "disabled" : "")>Xác nhận xóa</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>
